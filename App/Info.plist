<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- agentx://system etc. open a section (used by the widgets); AgentX Dev uses agentx-dev://. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(AGENTX_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- "stable" (installed with scripts/install.sh) or "dev" (scripts/run-dev.sh): see Core/AppChannel.swift. -->
	<key>AgentXChannel</key>
	<string>$(AGENTX_CHANNEL)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>The AgentX assistant reads and adds events when you ask it to.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>The AgentX assistant reads, adds and completes reminders when you ask it to.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>The AgentX assistant uses Mail, Notes, Messages and System Events when you ask it to, and reads your browser's current tab or Finder's selection when you open the launcher.</string>
	<!-- The iPhone link (Settings → iPhone): only while an iPhone is paired or being paired. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>AgentX talks to the AgentX app on your paired iPhone over your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_agentx._tcp</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>AgentX listens only while you hold the launcher shortcut to talk (or click its microphone), or use voice mode in Claude chats.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AgentX turns what you say into text on this Mac (on-device recognition), only while you hold the launcher shortcut or click its microphone.</string>
	<key>NSHumanReadableCopyright</key>
	<string>AgentX, powered by Claude.</string>
	<!-- AgentX Dev only: where the agent-core sidecar lives (the repo checkout). Empty in installed builds. -->
	<key>AgentXCorePath</key>
	<string>$(AGENTX_CORE_PATH)</string>
</dict>
</plist>
