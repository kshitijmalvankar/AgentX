// Copy to Config/Local.xcconfig (git-ignored) to sign with your own Apple
// Development certificate. It's free: add your Apple ID in Xcode → Settings →
// Accounts, create an "Apple Development" certificate (Manage Certificates… →
// +), then print your team id (the OU= value, 10 characters) with:
//     security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// Not the code in parentheses in the certificate's name: that's your personal id.
//
// A stable signature means macOS remembers Accessibility, Screen Recording
// and Automation permissions across rebuilds and updates.
AGENTX_SIGN_IDENTITY = Apple Development
AGENTX_SIGN_STYLE = Manual
AGENTX_TEAM = ABCDE12345
